@model UserManagement.Web.ViewModels.Account.CreateUserViewModel
@{ ViewData["Title"] = "Add user"; }
<div class="page-heading"><div><div class="page-eyebrow">USER DIRECTORY</div><h2>Add a new user</h2><p class="page-subtitle">Create an account and assign the default user role.</p></div></div>
<div class="form-card">
    <div class="form-card-heading"><span class="form-heading-icon"><i class="bi bi-person-plus"></i></span><div><h3>User details</h3><p>Enter the new user's information below.</p></div></div>
    <form asp-controller="Users" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid">
            <div class="form-field"><label asp-for="Username" class="form-label">Username</label><input asp-for="Username" class="form-control" placeholder="Choose a username" autocomplete="off" /><span asp-validation-for="Username" class="field-validation"></span></div>
            <div class="form-field"><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control" placeholder="Enter full name" /><span asp-validation-for="FullName" class="field-validation"></span></div>
            <div class="form-field full-width"><label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" /><span asp-validation-for="Email" class="field-validation"></span></div>
            <div class="form-field"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" class="form-control" placeholder="At least 8 characters" autocomplete="new-password" /><span asp-validation-for="Password" class="field-validation"></span></div>
            <div class="form-field"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-validation"></span></div>
        </div>
        <div class="form-actions"><a asp-action="Index" class="btn-secondary-soft">Cancel</a><button type="submit" class="btn-primary-soft"><i class="bi bi-check2"></i> Create user</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
