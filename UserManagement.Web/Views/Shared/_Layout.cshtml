<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UserManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UserManagement.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-layout">
        <aside class="sidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-grid-1x2-fill"></i></span>
                <span>User<span class="brand-accent">Management</span></span>
            </a>

            <div class="sidebar-label">WORKSPACE</div>
            <nav class="nav flex-column sidebar-nav">
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-link" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-people"></i><span>Users</span>
                    </a>
                }
            </nav>

            <div class="sidebar-bottom">
                <div class="sidebar-label">ACCOUNT</div>
                <div class="sidebar-user">
                    <div class="sidebar-avatar"><i class="bi bi-person-fill"></i></div>
                    <div class="sidebar-user-info">
                        <strong>@User.Identity.Name</strong>
                        <small>@(User.IsInRole("Admin") ? "Administrator" : "User")</small>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-link">
                        <i class="bi bi-box-arrow-left"></i><span>Sign out</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="main-content">
            <header class="topbar">
                <div>
                    <div class="topbar-eyebrow">USER MANAGEMENT SYSTEM</div>
                    <h1 class="topbar-title">@ViewData["Title"]</h1>
                </div>
                <div class="topbar-right">
                    <span class="topbar-status"><span></span> System online</span>
                    <div class="topbar-avatar">@((User.Identity?.Name?.Length ?? 0) > 0 ? User.Identity!.Name![0].ToString().ToUpperInvariant() : "U")</div>
                </div>
            </header>

            <main class="page-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© 2026 UserManagement</span>
                <span>Secure user administration</span>
            </footer>
        </div>
    </div>
}
else
{
    @RenderBody()
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
